+#[test]
+fn intercepted_drag_cancel_outside_viewport_still_ends_on_source() {
+    let mut vm = new_rendered_test_vm("https://drag-intercept-outside.test/", DRAG_INTERCEPT_PAGE);
+    vm.eval(DRAG_INTERCEPT_LISTENERS)
+        .expect("drag listener setup should evaluate");
+    let data = drag_data_from(&start_intercepted_drag(&mut vm));
+    vm.dispatch_drag_event_at_point(-100.0, -100.0, "dragleave", data, 0)
+        .expect("cancel outside viewport");
+    vm.dispatch_mouse_event_at_point(20.0, 120.0, "mouseup", 0, Some(0), 0.0, 0.0)
+        .expect("late mouseup");
+    assert_eq!(
+        vm.eval("window.__dragLog.join('|')").expect("log"),
+        "dragstart|dragend"
+    );
+}
